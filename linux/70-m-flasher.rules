# JieLi download mode (USB disk "WL82 UBOOT1.00", 4C4A:8057): let users in
# the wheel group and the logged-in user send it SCSI commands, so that
# M-Flasher runs without root.
#   sudo cp 70-m-flasher.rules /etc/udev/rules.d/ && sudo udevadm control --reload
SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="4c4a", ATTRS{idProduct}=="8057", MODE="0660", GROUP="wheel", TAG+="uaccess"
# the same for the USB device itself (a build with the `usb` feature talks to
# it through libusb, as on macOS)
SUBSYSTEM=="usb", ATTR{idVendor}=="4c4a", ATTR{idProduct}=="8057", MODE="0660", GROUP="wheel", TAG+="uaccess"
